# ─────────────────────────────────────────────────
# Frontend Environment Variables (.env)
# ─────────────────────────────────────────────────

# Environment
VITE_APP_ENV=development
VITE_SITE_URL=https://www.xaikorea.ai.kr
VITE_SITE_DOMAIN=xaikorea.ai.kr
VITE_SITE_CNAME=www.xaikorea.ai.kr

# Shared Cloudflare Worker API used by GitHub Pages and the team preview.
# Development example: http://127.0.0.1:8787/contact
# Production example: https://api.xaikorea.ai.kr/contact
VITE_CONTACT_API_URL=http://127.0.0.1:8787/contact

# Cloudflare Turnstile public site key. The following key always passes and is
# for local development only. Replace it in every production environment.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ─────────────────────────────────────────────────
# Backend Environment Variables (Cloudflare Worker secrets)
# ─────────────────────────────────────────────────
# These are stored as Cloudflare Worker secrets, NOT in this file!
#
# TURNSTILE_SECRET_KEY        - Turnstile server secret (required)
# GOOGLE_OAUTH_CLIENT_ID      - Google OAuth client ID (required, secret binding)
# GOOGLE_OAUTH_CLIENT_SECRET  - Google OAuth client secret (required)
# GOOGLE_OAUTH_REFRESH_TOKEN  - offline token for the Workspace sender (required)
# GMAIL_SENDER_ADDRESS        - licensed Workspace mailbox that granted access
# CONTACT_RECIPIENT           - contact@xaikorea.ai.kr
# ALLOWED_ORIGINS             - exact comma-separated website origins
